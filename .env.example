# ─────────────────────────────────────────────────────────────
#  Stock Picker Agent — Environment Variables
#  Copy this file to .env and fill in your keys
#  ⚠️  Never commit .env to version control!
# ─────────────────────────────────────────────────────────────

# Groq (LLM backend — free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Serper (Google Search API — free tier: https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# OpenAI (used only for embeddings / crew memory)
# Get a key at https://platform.openai.com/api-keys
# You can also swap this for a local embedder — see README
OPENAI_API_KEY=your_openai_api_key_here
